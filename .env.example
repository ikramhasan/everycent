# Postgres (docker compose)
DATABASE_URL=postgres://everycent:everycent@localhost:5432/everycent
TEST_DATABASE_URL=postgres://everycent:everycent@localhost:5432/everycent_test

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public URL the browser uses to reach /api/auth (the Vite dev server proxies it)
BETTER_AUTH_URL=http://localhost:5173
# Origin of the web app (CORS + Better Auth trusted origin)
WEB_ORIGIN=http://localhost:5173

PORT=3000

# Email (Resend). Without a key, development prints emails (and their links) to the API console.
# Both are required in production. FROM_EMAIL is an address, "Name <address>", or a verified
# sending domain (sent as no-reply@ that domain).
RESEND_API_KEY=
FROM_EMAIL=
# Optional: comma-separated CIDRs of reverse proxies in front of the API, so rate limits trust
# x-forwarded-for only through them.
TRUSTED_PROXIES=

# Optional: personal access token for the YNAB *test* account (see CLAUDE.md, "Matching YNAB")
YNAB_TOKEN=
