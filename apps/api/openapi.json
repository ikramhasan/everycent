          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "description": "In display order, hidden ones included"
          }
        },
        "required": [
          "id",
          "name",
          "hidden",
          "categories"
        ]
      },
