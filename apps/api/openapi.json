            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryGroup": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "MoveCategoryGroup": {
        "type": "object",
        "properties": {
          "beforeGroupId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Place the group right before this one; null moves it to the end"
          }
        },
        "required": [
          "beforeGroupId"
        ]
      },
      "CreateCategory": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "groupId",
          "name"
        ]
      },
      "UpdateCategory": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "note": {
            "type": "string",
            "maxLength": 10000
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "MoveCategory": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string",
            "description": "The group to move the category into"
          },
          "beforeCategoryId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Place it right before this category in that group; null moves it to the end"
          }
        },
        "required": [
          "groupId",
          "beforeCategoryId"
        ]
      }
    },
    "parameters": {}
