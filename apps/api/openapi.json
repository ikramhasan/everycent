              "DD-MM-YYYY"
            ],
            "description": "How dates are displayed"
          }
        },
        "additionalProperties": false,
        "description": "The currency can't be changed after creation."
      },
      "CategoryList": {
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryGroup"
            },
            "description": "In display order"
          }
        },
        "required": [
          "groups"
        ]
      },
      "CategoryGroup": {
        "type": "object",
