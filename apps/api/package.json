{
  "name": "@everycent/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "openapi:emit": "tsx src/scripts/emit-openapi.ts",
